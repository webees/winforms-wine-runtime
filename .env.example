# Copy to .env and adjust. Never commit .env.
# Compose only auto-loads .env from the compose file's directory, so either use
#   docker compose --env-file .env -f examples/docker-compose.yml up
# or copy this file to examples/.env. Full variable list: README "Environment".
VNC_PASSWORD=change-me
SCREEN=1600x900x24
KASMVNC_PORT=6901
# 1 = HTTPS with a generated self-signed certificate; 0 behind a TLS proxy.
KASMVNC_SSL=1
